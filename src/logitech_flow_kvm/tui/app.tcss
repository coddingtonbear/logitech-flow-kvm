Screen {
    layout: vertical;
}

StatusPanel {
    height: auto;
    max-height: 40%;
    border: solid $accent;
    padding: 0 1;
}

/* The log is just a log: no border, no scrollbars, no focus highlight --
   lines word-wrap to the terminal width and the newest stay in view. */
RichLog {
    height: 1fr;
    scrollbar-size: 0 0;
    &:focus {
        background-tint: transparent;
    }
}
